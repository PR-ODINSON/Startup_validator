PORT=3001
NODE_ENV=development

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=your_supabase_url_here
# Client / publishable key (frontend later); same as SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
# Server writes (Nest backend). Legacy: service_role JWT, or new: sb_secret_… key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key_here
# Optional alias if your dashboard labels the server key this way:
# SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Optional, for future JWT auth verification:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google Gemini (optional; not used by current Groq pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (LangChain agents)
GROQ_API_KEY=your_groq_api_key_here
# Pause between pipeline agents to stay under Groq TPM (ms). Default 20000.
# PIPELINE_AGENT_COOLDOWN_MS=20000

# Tavily (research agent web search — https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
